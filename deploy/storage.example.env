MUSE_LIB_REMOTE=storage-ro:bucket/lib
MUSE_CATALOG_REMOTE=storage-ro:bucket/catalog/state.sqlite
# Login of the mount's local remote control (127.0.0.1:5572), read by rclone itself from the environment, never from argv; use a long random password.
RCLONE_RC_USER=muse-lib
RCLONE_RC_PASS=change-me-openssl-rand-hex-24
