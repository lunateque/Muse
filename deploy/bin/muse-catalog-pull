#!/bin/sh
set -eu
data=/srv/muse/data
pending=/var/lib/muse-lib-pending
backstop=/var/lib/muse-lib-backstop
rc=http://127.0.0.1:5572/vfs/refresh
call_max_s=60
budget_ms=300000
backstop_every_min=1440
tab=$(printf '\t')
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
now() { date +%s%3N; }
rc_post() {
  max=$1; shift
  printf 'user = "%s:%s"\n' "$RCLONE_RC_USER" "$RCLONE_RC_PASS" | curl -sS --fail --max-time "$max" -K - "$@" "$rc"
}
# One non-recursive refresh of one directory listing; "/" is the library root.
refresh_dir() {
  if [ "$1" = / ]; then
    out=$(rc_post "$call_max_s" -d recursive=false) || return 1
  else
    out=$(rc_post "$call_max_s" --data-urlencode "dir=$1" -d recursive=false) || return 1
  fi
  case $out in
    *Failed*) return 1 ;;
    *': "OK"'* | *': "file does not exist"'*) return 0 ;;
  esac
  return 1
}
# Is $1 below a directory that is still unfinished (listed in file $2)? Its parent listing is stale then.
below_unfinished() {
  [ -s "$2" ] && D=$1 awk 'BEGIN { d = ENVIRON["D"] "/" } $0 == "/" || index(d, $0 "/") == 1 { found = 1 } END { exit !found }' "$2"
}
# Refreshes the directories listed in file $1, shallow first, until the budget is used up. Every directory
# that is not done (failed, timed out, below an unfinished one, or not started) becomes the pending file.
refresh_dirs() {
  left="$pending.next"
  : > "$left"
  stopped=
  started=$(now)
  while IFS= read -r dir; do
    if [ -z "$stopped" ] && [ $(($(now) - started)) -ge "$budget_ms" ]; then
      stopped=1
      echo "catalog: refresh budget of $budget_ms ms used up" >&2
    fi
    if [ -n "$stopped" ] || below_unfinished "$dir" "$left"; then
      printf '%s\n' "$dir" >> "$left"
      continue
    fi
    began=$(now)
    if refresh_dir "$dir"; then
      echo "catalog: refreshed $dir in $(($(now) - began)) ms"
    else
      echo "catalog: refresh of $dir failed after $(($(now) - began)) ms" >&2
      printf '%s\n' "$dir" >> "$left"
    fi
  done < "$1"
  if [ -s "$left" ]; then
    echo "catalog: $(wc -l < "$left") directories left for the next run" >&2
    mv -f "$left" "$pending"
  else
    rm -f "$left" "$pending"
  fi
}
# Once a day: a recursive refresh in the mount's background (the rc call returns a job id at once),
# for whatever a catalog diff cannot see.
backstop_due() { ! find "$backstop" -mmin "-$backstop_every_min" 2>/dev/null | grep -q .; }
refresh_async() {
  if out=$(rc_post 15 -d recursive=true -d _async=true) && [ "${out#*jobid}" != "$out" ]; then
    touch "$backstop"
    echo "catalog: full refresh started in the background"
  else
    echo "catalog: background refresh not started" >&2
  fi
}
identity_columns() {
  sqlite3 -readonly "$1" "SELECT COUNT(*) FROM pragma_table_info('tracks') WHERE name IN ('size', 'mtime_ns');"
}
# Library-relative paths of playable tracks that are new, gone, or whose file identity (size, mtime_ns)
# changed between the live catalog (main) and the fresh one ($1). Without the identity columns on
# both sides only new and gone paths count. "/" stands for a genre directory that is new to the mount.
changed_paths() {
  old=$(identity_columns "$data/state.sqlite") || return 1
  new=$(identity_columns "$1") || return 1
  if [ "$old" = 2 ] && [ "$new" = 2 ]; then
    identity=1 size=size mtime=mtime_ns
  else
    identity=0 size=NULL mtime=NULL
  fi
  sqlite3 -readonly "$data/state.sqlite" "
ATTACH '$1' AS fresh;
CREATE TEMP TABLE o AS SELECT replace(path, char(92), '/') AS path, $size AS size, $mtime AS mtime_ns
  FROM main.tracks WHERE status = 'ok' AND path IS NOT NULL;
CREATE TEMP TABLE f AS SELECT replace(path, char(92), '/') AS path, $size AS size, $mtime AS mtime_ns
  FROM fresh.tracks WHERE status = 'ok' AND path IS NOT NULL;
CREATE INDEX temp.o_path ON o(path);
CREATE INDEX temp.f_path ON f(path);
SELECT path FROM f WHERE path NOT IN (SELECT path FROM o)
UNION SELECT path FROM o WHERE path NOT IN (SELECT path FROM f)
UNION SELECT f.path FROM f JOIN o ON o.path = f.path
  WHERE $identity = 1 AND (o.size IS NOT f.size OR o.mtime_ns IS NOT f.mtime_ns)
UNION SELECT '/' WHERE EXISTS (
  SELECT 1 FROM f WHERE instr(path, '/') > 0
    AND substr(path, 1, instr(path, '/') - 1) NOT IN (
      SELECT substr(path, 1, instr(path, '/') - 1) FROM o WHERE instr(path, '/') > 0));
"
}
# Paths on stdin -> every directory above them (genre, artist, album), deduplicated, shallow first.
ancestor_dirs() {
  awk '
    { gsub(/\\/, "/"); dir = $0 }
    sub(/\/[^\/]*$/, "", dir) == 0 || dir == "" { printf "%d\t/\n", -1; next }
    {
      n = split(dir, part, "/"); acc = ""
      for (i = 1; i <= n; i++) {
        acc = (i == 1) ? part[i] : acc "/" part[i]
        printf "%d\t%s\n", i - 1, acc
      }
    }' | LC_ALL=C sort -t "$tab" -k1,1n -k2 -u | cut -f2-
}
retry_pending() {
  [ -s "$pending" ] && refresh_dirs "$pending"
  return 0
}
remote_md5=$(rclone md5sum "$MUSE_CATALOG_REMOTE" | cut -d' ' -f1)
[ -n "$remote_md5" ] || { echo "catalog: remote missing" >&2; exit 1; }
local_md5=$(md5sum "$data/state.sqlite" 2>/dev/null | cut -d' ' -f1 || true)
if [ "$remote_md5" = "$local_md5" ]; then
  retry_pending
  if backstop_due; then refresh_async; fi
  exit 0
fi
tmp="$data/.state.sqlite.new"
rclone copyto "$MUSE_CATALOG_REMOTE" "$tmp"
[ "$(md5sum "$tmp" | cut -d' ' -f1)" = "$remote_md5" ] || { rm -f "$tmp"; echo "catalog: md5 mismatch" >&2; exit 1; }
[ "$(sqlite3 -readonly "$tmp" 'PRAGMA integrity_check;')" = "ok" ] || { rm -f "$tmp"; echo "catalog: integrity failed" >&2; exit 1; }
chown muse:muse "$tmp"; chmod 640 "$tmp"
if changed_paths "$tmp" > "$work/paths"; then
  ancestor_dirs < "$work/paths" > "$work/changed"
else
  : > "$work/changed"
  rm -f "$backstop"
  echo "catalog: cannot compare with the live catalog, a full refresh follows in the background" >&2
fi
{ cat "$pending" 2>/dev/null || true; cat "$work/changed"; } | awk '!seen[$0]++' > "$work/plan"
refresh_dirs "$work/plan"
mv -f "$tmp" "$data/state.sqlite"
echo "catalog: updated $remote_md5"
if backstop_due; then refresh_async; fi
